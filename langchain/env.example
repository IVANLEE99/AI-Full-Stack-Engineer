# 读者复制为 .env 后填写；不要提交 .env 或在浏览器端使用这些密钥。
# 默认离线运行不读取 .env，也不根据密钥是否存在切换到付费 API。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# 必须同时显式指定 --live --trace 才上传匿名练习链路。
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-node-tutorial

# --remote 才连接远程 MCP；PostgreSQL 仅为课程扩展，不是默认运行依赖。
MCP_SERVER_URL=
DATABASE_URL=
